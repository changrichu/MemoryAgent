# ===========================================
# MemoryAgent 环境变量配置(请复制为 .env)
# ===========================================

# ----- LLM API 配置 -----
# 兼容 OpenAI 接口格式的 API(支持 OpenAI / DeepSeek / 通义千问 / 智谱 等)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ----- Embedding 模型 -----
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu

# ----- Re-ranker 模型 -----
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# ----- Redis (L1 工作记忆) -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ----- PostgreSQL (L2 情景记忆) -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=memoryagent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# ----- Milvus (L3 长期记忆) -----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=Milvus

# ----- Neo4j (知识图谱,可选) -----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123

# ----- 业务参数 -----
L1_MAX_MESSAGES=10
L2_SUMMARY_TRIGGER=10
L3_TOP_K=20
FINAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.6

# ----- Langfuse 监控(可选) -----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ----- 服务端口 -----
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
